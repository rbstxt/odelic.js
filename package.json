{
  "name": "odelic",
  "version": "0.2.0",
  "description": "Unofficial TypeScript/Node.js library for ODELIC Bluetooth lights (Pairlink connected-mesh)",
  "type": "module",
  "license": "MIT",
  "author": "rbstxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbstxt/odelic.js.git"
  },
  "homepage": "https://github.com/rbstxt/odelic.js#readme",
  "bugs": {
    "url": "https://github.com/rbstxt/odelic.js/issues"
  },
  "keywords": [
    "odelic",
    "bluetooth",
    "ble",
    "mesh",
    "lighting",
    "smart-home",
    "mcp",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "odelic": "bin/odelic.js",
    "odelic-mcp": "bin/odelic-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.8.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "zod": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
